{
  "name": "@neoboard/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "neoboard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude src/__tests__/integration/**",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude src/__tests__/integration/**",
    "test:integration": "vitest run src/__tests__/integration/ --test-timeout 120000"
  },
  "dependencies": {
    "chalk": "^5.0.0",
    "commander": "^13.0.0",
    "dotenv": "^17.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
