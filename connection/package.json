{
  "name": "@neoboard/connection",
  "version": "1.0.0",
  "description": "Database connection adapters for NeoBoard",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredo1996/neoboard.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector-types": {
      "types": "./dist/connector-types.d.ts",
      "import": "./dist/connector-types.js"
    },
    "./form-fields": {
      "types": "./dist/form-fields.d.ts",
      "import": "./dist/form-fields.js"
    },
    "./query-languages": {
      "types": "./dist/query-languages.d.ts",
      "import": "./dist/query-languages.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --testPathIgnorePatterns '/__tests__/utils/' '/dist/' '/__tests__/quality/' && jest __tests__/quality --runInBand",
    "test:coverage": "jest --testPathIgnorePatterns '/__tests__/utils/' '/dist/' '/__tests__/quality/' --coverage && jest __tests__/quality --runInBand --coverage --coverageDirectory=coverage-quality"
  },
  "dependencies": {
    "@neoboard/connector-sdk": "0.1.0",
    "neo4j-driver": "^6.2.0",
    "neo4j-driver-core": "^6.0.1",
    "pg": "^8.22.0",
    "pg-cursor": "^2.21.0"
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.4",
    "jest": "^30.4.2",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.4.12"
  },
  "private": true
}
