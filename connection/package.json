{
  "name": "@neoboard/connection",
  "version": "2.0.0",
  "description": "Database connection adapters for NeoBoard",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredo1996/neoboard.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connector-types": {
      "types": "./dist/connector-types.d.ts",
      "import": "./dist/connector-types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json 2>&1 || echo 'WARN: type errors exist (neo4j-driver-core upstream); output emitted via noEmitOnError:false'",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "neo4j-driver": "^6.0.1",
    "neo4j-driver-core": "^6.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^11.13.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "testcontainers": "^11.13.0",
    "ts-jest": "^29.4.9"
  },
  "private": true
}
