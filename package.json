{
  "name": "neoboard",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "workspaces": [
    "app",
    "component",
    "connection",
    "cli"
  ],
  "scripts": {
    "dev": "npm -w app run dev",
    "build": "npm -w connection run build && npm -w app run build",
    "test": "npm -w app run test && npm -w component run test && npm -w cli run test",
    "test:app": "npm -w app run test",
    "test:components": "npm -w component run test",
    "test:cli": "npm -w cli run test",
    "test:e2e": "npm -w app run test:e2e",
    "storybook": "npm -w component run storybook",
    "lint": "eslint .",
    "db:migrate": "npm -w app run db:migrate",
    "db:generate": "npm -w app run db:generate",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "neoboard": "node cli/dist/index.js",
    "cli:build": "npm -w cli run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "component/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "connection/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
