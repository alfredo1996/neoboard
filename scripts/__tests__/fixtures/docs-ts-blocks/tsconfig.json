{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "paths": {
      "@neoboard/connector-sdk": ["../../../../connector-sdk/src/index.ts"]
    }
  }
}
