                  }
                ]
              }
            }
          }
        ],
        "gridLayout": [
          { "i": "tm-md", "x": 0, "y": 0, "w": 12, "h": 3 },
          { "i": "tm-chart", "x": 0, "y": 3, "w": 12, "h": 7 }
        ]
      },
      {
        "id": "page-radar",
        "title": "8. Radar",
        "widgets": [
          {
            "id": "rd-md",
            "chartType": "markdown",
            "connectionId": "conn_postgres_read",
            "query": "",
            "settings": {
              "title": "",
              "chartOptions": {
                "content": "## Styling rules — Radar\n\nRules color the radar polygon based on the average value across its indicators.\n\n**Rules shown:**\n- `avg >= 500` → blue\n- `avg <  500` → grey"
              }
            }
          },
          {
            "id": "rd-chart",
            "chartType": "radar",
            "connectionId": "conn_postgres_read",
            "query": "SELECT 'orders' AS indicator, COUNT(*)::float AS value FROM neoboard_demo_public.orders UNION ALL SELECT 'customers', COUNT(*)::float FROM neoboard_demo_public.customers UNION ALL SELECT 'products', COUNT(*)::float FROM neoboard_demo_public.products UNION ALL SELECT 'order_items', COUNT(*)::float FROM neoboard_demo_public.order_items UNION ALL SELECT 'regions', COUNT(*)::float FROM neoboard_demo_public.regions",
            "settings": {
              "title": "Dataset magnitudes — styled by average",
              "chartOptions": {
                "shape": "polygon",
                "filled": true,
                "showLegend": true
              },
              "stylingConfig": {
                "enabled": true,
                "rules": [
                  {
                    "id": "rd-r1",
                    "operator": ">=",
                    "value": 500,
                    "color": "#2563eb",
                    "target": "color"
                  },
                  {
                    "id": "rd-r2",
                    "operator": "<",
                    "value": 500,
                    "color": "#94a3b8",
                    "target": "color"
                  }
                ]
              }
            }
          }
        ],
        "gridLayout": [
          { "i": "rd-md", "x": 0, "y": 0, "w": 12, "h": 3 },
          { "i": "rd-chart", "x": 2, "y": 3, "w": 8, "h": 6 }
        ]
      },
      {
        "id": "page-table",
        "title": "9. Table",
        "widgets": [
          {
            "id": "tbl-md",
            "chartType": "markdown",
            "connectionId": "conn_postgres_read",
            "query": "",
            "settings": {
              "title": "",
              "chartOptions": {
                "content": "## Styling rules — Table\n\nTables are the richest styling target. Each rule can scope to a specific column (`column: 'margin'`) and use any of the three targets: `color`, `backgroundColor`, `textColor`. Multiple rules can stack on the same row.\n\n**Rules shown:**\n- `margin > 100` on column `margin` → green text + bold\n- `margin <= 0`  on column `margin` → red backgroundColor\n- `product contains 'Ultra'` on column `product` → indigo textColor"
              }
            }
          },
          {
            "id": "tbl-widget",
            "chartType": "table",
            "connectionId": "conn_postgres_read",
            "query": "SELECT p.name AS product, p.price::float AS price, p.cost::float AS cost, (p.price - p.cost)::float AS margin FROM neoboard_demo_public.products p ORDER BY margin DESC",
            "settings": {
              "title": "Product margins — multi-rule, multi-target",
              "chartOptions": {
                "enableSorting": true,
                "enablePagination": true,
                "pageSize": 15,
                "enableColumnResizing": true
              },
              "stylingConfig": {
                "enabled": true,
                "rules": [
                  {
                    "id": "tbl-r1",
                    "column": "margin",
                    "operator": ">",
                    "value": 100,
                    "color": "#16a34a",
                    "target": "color",
                    "bold": true
                  },
                  {
                    "id": "tbl-r2",
                    "column": "margin",
                    "operator": "<=",
                    "value": 0,
                    "color": "#fee2e2",
                    "target": "backgroundColor"
                  },
                  {
                    "id": "tbl-r3",
                    "column": "product",
                    "operator": "contains",
                    "value": "Ultra",
                    "color": "#4f46e5",
                    "target": "textColor"
                  }
                ]
              }
            }
          }
        ],
        "gridLayout": [
          { "i": "tbl-md", "x": 0, "y": 0, "w": 12, "h": 4 },
          { "i": "tbl-widget", "x": 0, "y": 4, "w": 12, "h": 8 }
        ]
      }
    ]
  }
