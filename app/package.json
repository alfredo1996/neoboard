{
  "name": "@neoboard/app",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alfredo1996/neoboard.git"
  },
  "scripts": {
    "predev": "node ../scripts/generate-plugin-imports.mjs && npm --prefix ../connector-sdk run build && npm --prefix ../connection run build",
    "prebuild": "node ../scripts/generate-plugin-imports.mjs && npm --prefix ../connector-sdk run build && npm --prefix ../connection run build",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ../scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:coverage": "E2E_COVERAGE=1 npx playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neoboard/components": "*",
    "@neoboard/connection": "*",
    "@neoboard/connector-sdk": "*",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@neoboard/enterprise": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "nextcov": "^1.5.4",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "^12.0.4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
